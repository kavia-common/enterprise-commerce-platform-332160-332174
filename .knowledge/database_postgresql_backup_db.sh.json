{"is_source_file": true, "format": "bash", "description": "This script performs automated backups for various database systems (SQLite, PostgreSQL, MySQL, MongoDB). It detects which database is running and creates a backup accordingly.", "external_files": ["/usr/lib/postgresql/", "/usr/lib/postgresql/*/bin", "/var/run/mysqld/mysqld.sock"], "external_methods": ["pg_isready", "ls", "mysqladmin", "mysql", "mysqldump", "mongosh", "mongodump"], "published": [], "classes": [], "methods": [], "calls": ["ls /usr/lib/postgresql/", "sudo -u postgres ${PG_BIN}/pg_isready", "cp \"${DB_NAME}\" \"database_backup.db\"", "mongosh --port ${DB_PORT} --eval \"db.adminCommand('ping')\"", "mongodump --port ${DB_PORT} --db ${DB_NAME} --archive=database_backup.archive --quiet", "mysqladmin ping -h localhost -P ${DB_PORT} --silent", "sudo mysqladmin ping --socket=/var/run/mysqld/mysqld.sock --silent", "mysql -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD}", "mysqldump -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD} --databases ${DB_NAME} --add-drop-database --routines --triggers --single-transaction", "mysql -h localhost -P ${DB_PORT} -u root -p${DB_PASSWORD}", "sudo mysql --socket=/var/run/mysqld/mysqld.sock -u root -p${DB_PASSWORD}", "sudo mysqldump --socket=/var/run/mysqld/mysqld.sock -u root -p${DB_PASSWORD}", "sudo mysql --socket=/var/run/mysqld/mysqld.sock -u root", "sudo mysqldump --socket=/var/run/mysqld/mysqld.sock -u root", "mongosh --port ${DB_PORT} --eval \"db.adminCommand('ping')\"", "mongodump --port ${DB_PORT} --db ${DB_NAME} --archive=database_backup.archive --quiet"], "search-terms": ["backup_db.sh", "database backup", "PostgreSQL backup", "MySQL backup", "MongoDB backup", "SQLite", "detect database type", "database system check"], "state": 2, "file_id": 7, "knowledge_revision": 14, "git_revision": "c0beb3b55b149ecf2754867b2be8eccb2621ec56", "hash": "7af9aa35fa4940f934d83f6e2621b732", "format-version": 4, "code-base-name": "database_postgresql", "filena